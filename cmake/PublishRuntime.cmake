cmake_minimum_required(VERSION 3.24)

file(MAKE_DIRECTORY "${DESTINATION}")
file(LOCK "${LOCK}" GUARD PROCESS TIMEOUT 60)

string(RANDOM LENGTH 12 nonce)
foreach(kind IN ITEMS BINARY PDB)
    get_filename_component(filename "${${kind}}" NAME)
    set(published_${kind} "${DESTINATION}/${filename}")
    set(staged_${kind} "${DESTINATION}/.${filename}.${nonce}.tmp")
    if(NOT EXISTS "${${kind}}")
        message(FATAL_ERROR "Build output missing: ${${kind}}")
    endif()
endforeach()

foreach(kind IN ITEMS BINARY PDB)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
        "${${kind}}" "${published_${kind}}"
        RESULT_VARIABLE comparison OUTPUT_QUIET ERROR_QUIET)
    if(comparison STREQUAL "0")
        continue()
    endif()
    file(COPY_FILE "${${kind}}" "${staged_${kind}}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${staged_BINARY}" "${staged_PDB}")
        message(FATAL_ERROR "Could not stage ${${kind}}: ${result}")
    endif()
endforeach()

# Each rename is atomic. Save the previous binary so a failed PDB replacement
# leaves the previous pair in place.
set(backup "${staged_BINARY}.backup.tmp")
if(EXISTS "${staged_BINARY}")
    if(EXISTS "${staged_PDB}" AND EXISTS "${published_BINARY}")
        file(CREATE_LINK "${published_BINARY}" "${backup}" COPY_ON_ERROR RESULT result)
        if(NOT result STREQUAL "0")
            file(REMOVE "${staged_BINARY}" "${staged_PDB}" "${backup}")
            message(FATAL_ERROR "Could not back up ${published_BINARY}: ${result}")
        endif()
    endif()
    file(RENAME "${staged_BINARY}" "${published_BINARY}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${staged_BINARY}" "${staged_PDB}" "${backup}")
        message(FATAL_ERROR "Could not publish ${published_BINARY}: ${result}")
    endif()
    set(binary_replaced TRUE)
endif()
if(EXISTS "${staged_PDB}")
    file(RENAME "${staged_PDB}" "${published_PDB}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${staged_PDB}")
        if(EXISTS "${backup}")
            file(RENAME "${backup}" "${published_BINARY}" RESULT rollback)
            if(NOT rollback STREQUAL "0")
                message(FATAL_ERROR
                    "Could not publish ${published_PDB}: ${result}. "
                    "Could not restore ${published_BINARY} from ${backup}: ${rollback}")
            endif()
        elseif(binary_replaced)
            file(REMOVE "${published_BINARY}")
        endif()
        message(FATAL_ERROR "Could not publish ${published_PDB}: ${result}")
    endif()
endif()
file(REMOVE "${backup}")
