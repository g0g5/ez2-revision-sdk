include_guard(GLOBAL)

function(revision_resolve_shadercompile2 output)
    set(REVISION_SHADERCOMPILE2_EXECUTABLE "" CACHE FILEPATH
        "Optional absolute path to a local ShaderCompile2.exe for LUX")
    if(REVISION_SHADERCOMPILE2_EXECUTABLE)
        if(NOT IS_ABSOLUTE "${REVISION_SHADERCOMPILE2_EXECUTABLE}" OR
                NOT EXISTS "${REVISION_SHADERCOMPILE2_EXECUTABLE}" OR
                IS_DIRECTORY "${REVISION_SHADERCOMPILE2_EXECUTABLE}")
            message(FATAL_ERROR "REVISION_SHADERCOMPILE2_EXECUTABLE must point to an existing executable.")
        endif()
        set(${output} "${REVISION_SHADERCOMPILE2_EXECUTABLE}" PARENT_SCOPE)
        return()
    endif()

    set(revision c71803c9ff132003da991a6e3b12b6c8c5adafdc)
    set(expected_hash df13601822a642d1238d55e65522842fd776911f9e76c9fea1f4cfdf6f220230)
    set(url "https://raw.githubusercontent.com/LUX-Shaders-Team/LUX-Shaders/${revision}/src/devtools/bin/ShaderCompile2.exe")
    set(compiler "${REVISION_ROOT}/build/shader-tools/${revision}/ShaderCompile2.exe")
    file(LOCK "${compiler}.lock" GUARD FUNCTION TIMEOUT 300)
    if(EXISTS "${compiler}")
        file(SHA256 "${compiler}" actual_hash)
    endif()
    if(NOT actual_hash STREQUAL expected_hash)
        message(STATUS "Downloading LUX ShaderCompile2 (${revision})")
        set(download "${compiler}.part")
        file(DOWNLOAD "${url}" "${download}" TLS_VERIFY ON STATUS status
            INACTIVITY_TIMEOUT 30 TIMEOUT 300)
        list(GET status 0 code)
        list(GET status 1 detail)
        if(code EQUAL 0)
            file(SHA256 "${download}" actual_hash)
            if(NOT actual_hash STREQUAL expected_hash)
                set(detail "SHA-256 mismatch")
            endif()
        endif()
        if(NOT code EQUAL 0 OR NOT actual_hash STREQUAL expected_hash)
            file(REMOVE "${download}")
            message(FATAL_ERROR "Could not obtain ShaderCompile2 (${detail}). Set REVISION_SHADERCOMPILE2_EXECUTABLE to use a local copy.")
        endif()
        file(RENAME "${download}" "${compiler}")
    endif()
    set(${output} "${compiler}" PARENT_SCOPE)
endfunction()

function(revision_add_lux_shaders)
    find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
    revision_resolve_shadercompile2(_compiler)

    set(_base "${CMAKE_CURRENT_BINARY_DIR}/shader-build/lux")
    set(_shader_dir "${REVISION_SRC}/materialsystem/lux/stdshaders")
    set(_compat_dir "${REVISION_SRC}/materialsystem/stdshaders")
    set(_game_dir "${REVISION_ROOT}/sp/game/mod_ez2")
    set(_prep "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ShaderPrep.py")
    set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunShaderBuild.cmake")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_prep}")
    file(GLOB _includes_hlsl CONFIGURE_DEPENDS "${_shader_dir}/*.h" "${_compat_dir}/*.h")
    list(FILTER _includes_hlsl EXCLUDE REGEX "/(BaseVSShader|lux_compat|cpp_[^/]+)\\.h$")
    set(_lists_30 "${_shader_dir}/ShaderList_All.txt" "${_shader_dir}/ShaderList_Custom.txt"
        "${_compat_dir}/lux_compat_30.txt")
    set(_lists_20b "${_shader_dir}/ShaderList_PostProcess_vs20.txt" "${_compat_dir}/lux_compat_20b.txt")
    set(_headers)
    set(_bytecode)
    set(_includes)
    foreach(_model IN ITEMS 20b 30)
        set(_work "${_base}/${_model}")
        set(_outputs)
        set(_sources)
        set(_inputs ${_includes_hlsl})
        set(_lists ${_lists_${_model}})
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_lists})
        foreach(_list IN LISTS _lists)
            get_filename_component(_list_dir "${_list}" DIRECTORY)
            execute_process(COMMAND "${Python3_EXECUTABLE}" "${_prep}" lux-list "${_list}" "${_model}"
                RESULT_VARIABLE _result OUTPUT_VARIABLE _expanded ERROR_VARIABLE _error)
            if(NOT _result STREQUAL "0")
                message(FATAL_ERROR "Cannot expand ${_list} (${_result}): ${_error}")
            endif()
            string(REPLACE "\r" "" _expanded "${_expanded}")
            string(STRIP "${_expanded}" _expanded)
            string(REPLACE "\n" ";" _entries "${_expanded}")
            foreach(_entry IN LISTS _entries)
                string(REGEX REPLACE "-----.*$" "" _source "${_entry}")
                string(REGEX REPLACE "^.*-----" "" _name "${_entry}")
                string(TOLOWER "${_name}" _key)
                if(DEFINED _source_for_${_key})
                    if(NOT _source STREQUAL "${_source_for_${_key}}")
                        message(FATAL_ERROR "Conflicting LUX shader output ${_name} in ${_list}")
                    endif()
                    # The upstream Custom list repeats the templates from All.
                    continue()
                endif()
                set(_source_for_${_key} "${_source}")
                list(APPEND _sources "${_source}")
                list(APPEND _inputs "${_list_dir}/${_source}")
                list(APPEND _outputs "include/${_name}.inc" "shaders/fxc/${_name}.vcs")
                list(APPEND _headers "${_work}/include/${_name}.inc")
                list(APPEND _bytecode "${_work}/shaders/fxc/${_name}.vcs")
            endforeach()
        endforeach()
        if(NOT _outputs)
            message(FATAL_ERROR "No inputs for LUX shader model ${_model}")
        endif()
        list(APPEND _includes "${_work}/include")

        set(_manifest "${_base}/lux-${_model}.cmake")
        set(_content "")
        foreach(_var IN ITEMS _compiler _model _inputs _sources _outputs)
            string(APPEND _content "set(${_var} [==[${${_var}}]==])\n")
        endforeach()
        file(CONFIGURE OUTPUT "${_manifest}" CONTENT "${_content}" @ONLY)
        list(TRANSFORM _outputs PREPEND "${_work}/")
        add_custom_command(OUTPUT ${_outputs}
            COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${_manifest}" "-DWORK_DIR=${_work}"
                -DMODE=LUX -P "${_runner}"
            DEPENDS ${_inputs} ${_lists} "${_prep}" "${_runner}" "${_manifest}" "${_compiler}"
            COMMENT "Compile LUX shader bytecode and combo headers (${_model})"
            VERBATIM)
    endforeach()

    add_custom_target(revision_lux_bytecode DEPENDS ${_headers} ${_bytecode})
    revision_add_runtime_target(game_shader_dx9_ez2 SHARED "${_game_dir}/bin" OUTPUT_NAME game_shader_dx9)
    target_include_directories(game_shader_dx9_ez2_binary BEFORE PRIVATE ${_includes})
    add_dependencies(game_shader_dx9_ez2_binary revision_lux_bytecode)
    revision_publish_shaders(ez2 "${_game_dir}" ${_bytecode})
    add_dependencies(game_shader_dx9_ez2 shader_bytecode_ez2)
endfunction()
