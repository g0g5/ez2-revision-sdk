function(revision_fetch_sdk_library lib output)
    get_property(resolved GLOBAL PROPERTY "REVISION_SDK_LIBRARY_${lib}")
    if(resolved)
        set(${output} "${resolved}" PARENT_SCOPE)
        return()
    endif()

    list(GET revision_prebuilt_${lib} 0 folder)
    list(GET revision_prebuilt_${lib} 1 expected_hash)
    set(relative_path "${folder}/${lib}.lib")
    set(local_path "${REVISION_SRC}/lib/${relative_path}")
    if(lib MATCHES "^(steam_api|expanded_steam)$" AND NOT REVISION_STEAMWORKS_VERSION STREQUAL "1261")
        message(FATAL_ERROR
            "Missing ${lib}.lib for Steamworks ${REVISION_STEAMWORKS_VERSION}. "
            "Supply a matching Windows x86 library at ${local_path}.")
    endif()

    set(cached "${REVISION_SDK_LIBRARY_CACHE}/${revision_library_revision}/${relative_path}")
    file(LOCK "${cached}.lock" GUARD FUNCTION TIMEOUT 300)
    if(EXISTS "${cached}")
        file(SHA256 "${cached}" actual_hash)
    endif()
    if(NOT actual_hash STREQUAL expected_hash)
        if(NOT REVISION_DOWNLOAD_SDK_LIBRARIES)
            message(FATAL_ERROR
                "Missing or invalid Windows x86 SDK library ${lib}.lib. "
                "Place it at ${local_path} or enable REVISION_DOWNLOAD_SDK_LIBRARIES.")
        endif()
        message(STATUS "Downloading Windows x86 SDK library ${relative_path}")
        set(download "${cached}.part")
        file(DOWNLOAD "${revision_library_url}/${relative_path}" "${download}"
            TLS_VERIFY ON STATUS status INACTIVITY_TIMEOUT 30 TIMEOUT 300)
        list(GET status 0 code)
        list(GET status 1 detail)
        if(code EQUAL 0)
            file(SHA256 "${download}" actual_hash)
            if(NOT actual_hash STREQUAL expected_hash)
                set(detail "SHA-256 mismatch")
            endif()
        endif()
        if(NOT code EQUAL 0 OR NOT actual_hash STREQUAL expected_hash)
            file(REMOVE "${download}")
            message(FATAL_ERROR
                "Could not download ${relative_path} from ${revision_library_url} (${detail}). "
                "Place the Windows x86 SDK library at ${local_path} and reconfigure.")
        endif()
        file(RENAME "${download}" "${cached}")
    endif()

    set_property(GLOBAL PROPERTY "REVISION_SDK_LIBRARY_${lib}" "${cached}")
    set(${output} "${cached}" PARENT_SCOPE)
endfunction()
